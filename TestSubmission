  <!-- CI Journeys Form Embed -- Form Capture - Contact us Form -->

<script src='https://formui-usa1.mkt.dynamics.com.mcas.ms/usa/FormCapture/FormCapture.bundle.js?McasCtx=8389280&McasTsid=26311'></script>
<script>
    // NOTE: for reference see https://go.microsoft.com/fwlink/?linkid=2250770

    d365mktformcapture.waitForElement("#form1") // example: "#form1" as a selector for form with id="form1"
    .then(form => {
        const mappings = [
            {
                FormFieldName: "firstname",
                DataverseFieldName: "firstname",
            },
            {
                FormFieldName: "lastname",
                DataverseFieldName: "lastname",
            },
            {
                FormFieldName: "emailaddress1",
                DataverseFieldName: "emailaddress1",
            },
            {
                FormFieldName: "description",
                DataverseFieldName: "description",
            },
            {
                DataverseFieldName: "lvp_guidehouseservice",
                DataverseFieldValue: "{\"Id\":\"246e4c60-0d5b-ef11-a316-000d3a348f7e\",\"LogicalName\":\"lvp_guidehouseservice\"}",
            },
            {
                FormFieldName: "estimatedamount",
                DataverseFieldName: "estimatedamount",
            },

        ];

        form.addEventListener("submit", (e) => {
            const serializedForm = d365mktformcapture.serializeForm(form, mappings);
            // console.log(JSON.stringify(serializedForm)); // NOTE: enable for debugging
            const payload = serializedForm.SerializedForm.build();

            const captureConfig = {
                FormId: "c1e65ce7-0095-f111-8076-00224804f864",
                FormApiUrl: "https://public-usa.mkt.dynamics.com/api/v1.0/orgs/b577f57d-d194-4c27-b9c9-6cfdbdc904f6/landingpageforms"
            }
            d365mktformcapture.submitForm(captureConfig, payload);
        }, true);
    });
</script>
